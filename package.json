{
  "name": "property-fee-desktop",
  "version": "1.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json",
    "lint": "concurrently npm:typecheck npm:lint:eslint",
    "lint:eslint": "eslint src",
    "desktop": "electron .",
    "dist:win": "electron-builder --win --arm64",
    "dist:win-dir": "electron-builder --win --arm64 --dir"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.1.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.1.18",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.13.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "vite": "^8",
    "xlsx": "^0.18.5"
  },
  "main": "electron/main.cjs",
  "description": "物业收费系统（水电费台账 / 抄表 / 针式收据打印）",
  "build": {
    "appId": "com.hengji.propertyfee",
    "productName": "PropertyFee",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/client/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "PropertyFee-${version}-arm64.${ext}"
    },
    "portable": {
      "artifactName": "PropertyFee-${version}-arm64.${ext}"
    }
  }
}
